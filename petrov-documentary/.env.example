# Optional: ElevenLabs narration (scripts/generate-voiceover.ts). Without it the free local
# Kokoro voice is used. Never commit a real key.
ELEVENLABS_API_KEY=
# A deep American documentary voice ID from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=
# Path to the Kokoro ONNX model folder (model.onnx, am_michael.bin, am_onyx.bin) for the local voice
KOKORO_DIR=
# Python with kokoro-onnx, faster-whisper, scipy, soundfile installed
PYTHON=python3
# Optional: a local Chrome/Chromium for rendering
REMOTION_BROWSER=
